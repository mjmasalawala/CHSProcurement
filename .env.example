# Neon Postgres. DATABASE_URL is the pooled connection (used at runtime),
# DIRECT_URL is the unpooled connection (used by Prisma for migrations).
DATABASE_URL=""
DIRECT_URL=""

# Auth.js — signs/encrypts session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Optional for local dev — email/password login works without them.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend — sends new-registration notifications to the Bluejay team.
# https://resend.com/api-keys
RESEND_API_KEY=""
SUPPORT_EMAIL=""

# Sender address for all outbound emails. Optional — falls back to Resend's
# shared sandbox sender (onboarding@resend.dev), which can only deliver to
# your own Resend account email. Set this to a verified-domain address once
# you've verified a sending domain in Resend (https://resend.com/domains) to
# unlock real delivery to arbitrary recipients.
RESEND_FROM_EMAIL=""

# Signing secret for Resend's webhook (delivery/bounce/complaint events —
# see /api/webhooks/resend and Requirements/messaging-and-engagement-spec.md).
# Create the webhook at https://resend.com/webhooks pointed at
# <your-deployment-url>/api/webhooks/resend and copy its signing secret here.
# Until this is set, that route responds 501 rather than trusting an
# unsigned payload.
RESEND_WEBHOOK_SECRET=""

# Anthropic — powers the "Suggest line items" button on the vendor quote
# form (drafts line items from the requirement's description).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Vercel Blob — stores requirement photos (society requirement-creation
# wizard). Create a Blob store under your Vercel project's Storage tab,
# then copy the token it gives you (or run `vercel env pull` if the
# project is linked). https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# WhatsApp OTP delivery (Meta Cloud API) — see lib/whatsapp.ts. Needs a
# WhatsApp Business Platform phone number and an approved message template
# (body: "Your Wisesoc verification code is {{1}}. It expires in 10
# minutes."). Falls back to logging the code to the server console until
# all three are set.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE_NAME=""
# Optional — defaults to "en" if unset.
WHATSAPP_OTP_TEMPLATE_LANG=""

# Rest of the WhatsApp channel (Requirements/messaging-and-engagement-spec.md
# Phase 1) — sending outbox templates/free-text and receiving inbound
# messages, beyond just OTP.
# https://developers.facebook.com/apps → your app → WhatsApp → API Setup.
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# App Settings → Basic → App Secret. Verifies the X-Hub-Signature-256 header
# on incoming webhook deliveries so a forged payload is rejected.
WHATSAPP_APP_SECRET=""
# Not extracted from Meta — invent any random string yourself and enter the
# same value in the app's WhatsApp → Configuration webhook setup. Meta calls
# your endpoint once with this value to prove you control it.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Kill switch for every non-OTP outbound WhatsApp send (templates, free-text
# replies) — see lib/whatsapp.ts. Must be the literal string "true" to
# enable; anything else, including leaving it unset, disables it. OTP
# delivery (sendWhatsappOtp) is not gated by this — it predates this
# platform and phone verification already depends on it. Deploying code
# that wires a new event to WhatsApp should never by itself start sending —
# flip this deliberately, per environment, when you're ready to go live.
WHATSAPP_MESSAGING_ENABLED="false"
