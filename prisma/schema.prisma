// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A login identity. Separate from role — see unified-platform-architecture.md Section 3.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  // Null if the user only ever signs in via Google.
  passwordHash    String?
  // Collected + OTP-verified during invite acceptance (invite/[token] —
  // Vendor Owner registration sets name/phone directly at signup instead,
  // so this is specifically for invited Manager/Office Bearer/Vendor Staff
  // users). Both null until phoneVerifiedAt is stamped.
  phone           String?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roleAssignments         RoleAssignment[]
  bids                    Bid[]
  recommendedRequirements Requirement[]
  passwordResetTokens     PasswordResetToken[]
  quotationApprovals      QuotationApproval[]
  proposedChanges         ProposedChange[]     @relation("ProposedChangesProposer")
  approvedChanges         ProposedChange[]     @relation("ProposedChangesApprover")
  vendorSuggestions       VendorSuggestion[]
  phoneVerifications      PhoneVerification[]
  impersonationsStarted   ImpersonationEvent[] @relation("ImpersonationsStarted")
  impersonationsReceived  ImpersonationEvent[] @relation("ImpersonationsReceived")
}

// One-time code for the invite-acceptance flow's phone verification step
// (invite/[token] — Set password -> Name & Phone -> Verify OTP). No SMS
// provider is wired up yet (same placeholder as lib/sms.ts's sendSms) — the
// code is logged server-side (`[sms:stub] ...`) instead of actually
// delivered. A fresh row is created on every send/resend rather than
// updating one in place, so an old code can't be replayed after a resend.
model PhoneVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Forgot-password flow (landing-page-and-auth-flow-spec.md) — same
// single-use-token shape as Invite, but not tied to a RoleAssignment since
// it's not granting access, just letting an existing login set a new
// password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Support/Admin "act as another user" tooling (/support). Deliberately not
// folded into the JWT session — the real admin's NextAuth session cookie is
// never touched; a separate short-lived, unguessable `token` cookie points
// at this row, and auth.ts's session callback overlays the target user onto
// session.user only while the row is found, unexpired, and not ended. This
// row is the single source of truth for both authorization (is this token
// still live?) and the audit trail (who impersonated whom, when, and why) —
// ending impersonation is just stamping endedAt, no cookie/token juggling.
model ImpersonationEvent {
  id           String    @id @default(cuid())
  token        String    @unique
  adminUserId  String
  adminUser    User      @relation("ImpersonationsStarted", fields: [adminUserId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User      @relation("ImpersonationsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  reason       String
  startedAt    DateTime  @default(now())
  // Hard cap independent of an explicit "End" click — see startImpersonation.
  expiresAt    DateTime
  endedAt      DateTime?

  @@index([token])
  @@index([adminUserId])
}

enum EntityType {
  VENDOR_COMPANY
  SOCIETY
  PLATFORM
}

enum RoleName {
  VENDOR_OWNER
  VENDOR_STAFF
  MANAGER
  CHAIRMAN
  SECRETARY
  TREASURER
  // General Body member — a valid registrantRole for society self-registration
  // (society-portal-spec.md registration flow), but never gets a RoleAssignment
  // or portal login: holds no permissions and isn't an invitable role.
  GB_MEMBER
  OPS_VENDOR_QUEUE
  OPS_SOCIETY_QUEUE
  SUPER_ADMIN
  // Impersonation only (src/lib/permissions.ts IMPERSONATE_USER) — deliberately
  // narrower than SUPER_ADMIN, no other admin permissions by default.
  SUPPORT
}

enum RoleAssignmentStatus {
  // Created by an invite/registration approval, not yet accepted.
  PENDING
  ACTIVE
  // Owner-deactivated (Vendor Staff, v1) — past submissions stay attributed
  // to this assignment's user even after deactivation
  // (vendor-registration-portal-spec.md Section 2).
  DEACTIVATED
}

// Links a User to a specific entity (a Vendor Company or a Society) with a role
// and permission set. A User can hold multiple RoleAssignments (e.g. a Manager
// across several Societies). See unified-platform-architecture.md Section 3.
//
// entityId is a loose reference by design (entityType tells you which table —
// VendorCompany or Society — it points into; Prisma can't express a single FK
// that targets either table, so referential integrity here is app-level, not
// DB-level). PLATFORM roles (Wisesoc Ops/Super Admin) have no entity, so
// entityId is null for those.
model RoleAssignment {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType  EntityType
  entityId    String?
  role        RoleName
  // Effective permission strings for this assignment, seeded from role
  // defaults at creation time (see src/lib/permissions.ts) and independently
  // reassignable later without a code change, per the architecture doc.
  permissions String[]
  status      RoleAssignmentStatus @default(ACTIVE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  invite Invite?

  @@index([userId])
  @@index([entityType, entityId])
}

// Generic invite-acceptance mechanism (landing-page-and-auth-flow-spec.md
// Section 4), reused for Secretary/Manager/Chairman/Treasurer/Vendor Staff
// activation. Not used by Vendor Owner registration, which creates
// credentials directly at signup time (product decision, 2026-07-09 — see
// DEVELOPMENT_PLAN.md).
model Invite {
  id               String         @id @default(cuid())
  token            String         @unique
  email            String
  roleAssignmentId String         @unique
  roleAssignment   RoleAssignment @relation(fields: [roleAssignmentId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime       @default(now())
}

enum EntityStatus {
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  SUSPENDED
}

enum BusinessType {
  PROPRIETORSHIP
  PARTNERSHIP
  PRIVATE_LIMITED
  LLP
  OTHER
}

// Admin-managed, shared across Vendor registration, Society registration, and
// requirement creation — unified-platform-architecture.md Section 6.
model Category {
  id     String  @id @default(cuid())
  name   String  @unique
  // Soft-disable only — deactivating must not delete historical data tied to
  // it (admin-portal-spec.md Section 5).
  active Boolean @default(true)

  vendorCompanies VendorCompany[]
  requirements    Requirement[]
}

model City {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)

  vendorCompanies VendorCompany[]
  societies       Society[]
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A vendor's "this trade isn't on your list" request, submitted alongside
// registration but never blocking it — vendor-registration-portal-spec.md
// Section 5. Goes into an Admin approval queue (M3).
model CategoryRequest {
  id              String                @id @default(cuid())
  name            String
  status          CategoryRequestStatus @default(PENDING)
  reason          String?
  vendorCompanyId String?
  vendorCompany   VendorCompany?        @relation(fields: [vendorCompanyId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())
}

// vendor-registration-portal-spec.md Section 4.
model VendorCompany {
  id                String       @id @default(cuid())
  name              String
  businessType      BusinessType
  ownerName         String
  ownerPhone        String
  ownerEmail        String       @unique
  registeredAddress String
  gstNumber         String?
  panNumber         String?
  yearsInBusiness   Int?
  description       String?
  // Free-form, repeatable — supplementary metadata, not a matching input in
  // v1 (Section 6).
  societiesServiced String[]     @default([])
  status            EntityStatus @default(PENDING_VERIFICATION)
  rejectionReason   String?
  // Stamped when status flips to ACTIVE (admin/vendors/[id]/actions.ts) —
  // drives the admin dashboard's "approvals over time" chart. Null for
  // vendors still pending or rejected without ever being approved.
  approvedAt        DateTime?

  // Standard tier (Section 4.2) — schema-only, no v1 GUI. Nullable so
  // exposing them later needs no migration.
  tradeLicenseNumber    String?
  tradeLicenseExpiry    DateTime?
  insurancePolicyNumber String?
  insuranceCoverage     String?
  insuranceExpiry       DateTime?
  bankAccountNumber     String?
  bankIfsc              String?
  bankAccountHolderName String?

  serviceCategories  Category[]
  citiesServed       City[]
  categoryRequests   CategoryRequest[]
  requirementInvites RequirementInvite[]
  bids               Bid[]
  bidDrafts          BidDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// society-portal-spec.md Section 4.
model Society {
  id                 String       @id @default(cuid())
  name               String
  address            String
  cityId             String
  city               City         @relation(fields: [cityId], references: [id])
  unitsCount         Int
  registrationNumber String?
  registrantName     String
  registrantRole     RoleName
  registrantPhone    String
  registrantEmail    String
  secretaryName      String
  secretaryPhone     String
  secretaryEmail     String
  // Who the activation invite actually goes to, when it's someone other than
  // the registrant — e.g. a GB Member registrant naming a Manager/OB member
  // to run the account. Null means the invite goes to the registrant
  // themselves (registrant is already Manager/Secretary/Treasurer/Chairman).
  inviteeName        String?
  inviteeRole        RoleName?
  inviteePhone       String?
  inviteeEmail       String?
  status             EntityStatus @default(PENDING_VERIFICATION)
  rejectionReason    String?
  // Stamped when status flips to ACTIVE (admin/societies/[id]/actions.ts) —
  // drives the admin dashboard's "approvals over time" chart. Null for
  // societies still pending or rejected without ever being approved.
  approvedAt         DateTime?
  // Default ₹1,000, configurable per society (society spec Section 7).
  approvalThreshold  Int          @default(1000)

  // Captured at registration (optional) — shown as the "Bill To" GSTIN on a
  // vendor's GST-compliant quote PDF, alongside the vendor's own.
  gstNumber String?

  // Standard tier (Section 4.2) — schema-only, no v1 GUI.
  registrationCertificateUrl String?
  panNumber                  String?
  bankAccountNumber          String?
  bankIfsc                   String?
  bankAccountHolderName      String?

  requirements      Requirement[]
  proposedChanges   ProposedChange[]
  vendorSuggestions VendorSuggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A Society user's "here's a vendor you should invite" tip (society-portal
// spec, Suggest a Vendor) — stored purely as a record of who suggested whom,
// not linked to any resulting VendorCompany registration (the suggested
// vendor registers independently through the normal flow, same as any other
// vendor; there's no guarantee they use the same email, so auto-linking
// would be unreliable).
model VendorSuggestion {
  id        String  @id @default(cuid())
  societyId String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  suggestedByUserId String
  suggestedByUser   User   @relation(fields: [suggestedByUserId], references: [id])

  vendorName  String
  vendorPhone String?
  vendorEmail String

  createdAt DateTime @default(now())

  @@index([societyId])
}

enum ProposedChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// Generic "proposed change requires co-approval" mechanism (society-portal-
// spec.md Section 7.1) — applied first to approvalThreshold, one proposer +
// one different Office Bearer's approval, not the 2-of-3 quotation pattern.
model ProposedChange {
  id        String  @id @default(cuid())
  societyId String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  // Field name being changed, e.g. "approvalThreshold" — generic by design
  // so this isn't a one-off table for just the threshold.
  field     String
  oldValue  String
  newValue  String

  proposedByUserId String
  proposedByUser   User    @relation("ProposedChangesProposer", fields: [proposedByUserId], references: [id])
  approvedByUserId String?
  approvedByUser   User?   @relation("ProposedChangesApprover", fields: [approvedByUserId], references: [id])

  status    ProposedChangeStatus @default(PENDING)
  createdAt DateTime             @default(now())
  decidedAt DateTime?
}

enum RequirementUrgency {
  ROUTINE
  URGENT
}

// M6 — society-portal-spec.md Section 7. OPEN covers both "still bidding"
// and "closed, not yet recommended" (distinguished at render time via
// bidDeadline, not a separate stored state). The other three are explicit,
// event-driven states.
enum RequirementStatus {
  OPEN
  AWAITING_APPROVAL
  RETURNED_TO_MANAGER
  FINALIZED
}

// society-portal-spec.md Section 5. Requirement Creation (Manager-only,
// matching engine invite) lands in M5; the model existed a milestone early
// (M4) so the vendor portal had something real to point at.
model Requirement {
  id             String             @id @default(cuid())
  societyId      String
  society        Society            @relation(fields: [societyId], references: [id])
  // Many-to-many (product decision, 2026-07-13): a project can span more than
  // one trade — e.g. waterproofing + painting — and vendors in either trade
  // should be matched, not just ones who do both (see matchVendors).
  categories     Category[]
  name           String
  description    String
  urgency        RequirementUrgency
  // Free text (e.g. "₹10,000 - ₹25,000") — optional, no fixed band list yet.
  budgetBand     String?
  bidDeadline    DateTime
  // Optional photos (up to 5, see MAX_REQUIREMENT_PHOTOS) set at creation
  // time via the wizard's photos step — Vercel Blob URLs, array order is
  // display order. Visible to the society always; to vendors only once
  // RequirementInvite.contactRevealedAt is set, same gate as the society's
  // contact details, since photos can identify the building on their own.
  attachmentUrls String[]           @default([])

  status      RequirementStatus @default(OPEN)
  finalizedAt DateTime?

  // M7 — deadline-reminders cron (src/app/api/cron/deadline-reminders):
  // stamped the first time each reminder fires, so a still-OPEN requirement
  // never gets the same email/SMS twice on later cron runs.
  deadlineReminderSentAt   DateTime?
  deadlineClosedNotifiedAt DateTime?

  // Manager's recommendation (society-portal-spec.md Section 6).
  recommendedBidId    String?   @unique
  recommendedBid      Bid?      @relation("RequirementRecommendedBid", fields: [recommendedBidId], references: [id])
  // Mandatory if recommendedBid isn't the lowest submitted bid.
  recommendationNote  String?
  recommendedAt       DateTime?
  recommendedByUserId String?
  recommendedByUser   User?     @relation(fields: [recommendedByUserId], references: [id])

  invites            RequirementInvite[]
  bids               Bid[]
  bidDrafts          BidDraft[]
  quotationApprovals QuotationApproval[]
  workOrder          WorkOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

// One Office Bearer's vote on the *current* recommendation (society-portal-
// spec.md Section 7). Cleared and re-created fresh whenever the Manager
// re-recommends after a RETURNED_TO_MANAGER — see recommendBid in
// src/app/society/[id]/requirements/[reqId]/actions.ts — so stale votes
// from a superseded recommendation never carry over.
model QuotationApproval {
  id                 String           @id @default(cuid())
  requirementId      String
  requirement        Requirement      @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  officeBearerUserId String
  officeBearerUser   User             @relation(fields: [officeBearerUserId], references: [id])
  decision           ApprovalDecision
  decidedAt          DateTime         @default(now())

  @@unique([requirementId, officeBearerUserId])
}

enum FinalizationMethod {
  AUTO_BELOW_THRESHOLD
  OB_APPROVAL
}

// work-order-pdf-spec.md. Society/vendor identity fields are snapshotted at
// finalization time (not read live from Society/VendorCompany) so a
// historical Work Order PDF stays exactly as issued even if those profiles
// change later — see Section 5's storage requirement, done without needing
// a separate blob store since the source rows are already immutable by
// then.
model WorkOrder {
  id                String             @id @default(cuid())
  requirementId     String             @unique
  requirement       Requirement        @relation(fields: [requirementId], references: [id])
  bidId             String             @unique
  bid               Bid                @relation(fields: [bidId], references: [id])
  workOrderNumber   String             @unique
  finalizedVia      FinalizationMethod
  // "Approved by Chairman X, Secretary Y on <date>" or "Finalized by
  // Manager Z — below approval threshold".
  approvalSummary   String
  justificationNote String?

  societyNameSnapshot    String
  societyAddressSnapshot String
  vendorNameSnapshot     String
  vendorAddressSnapshot  String
  vendorContactSnapshot  String

  createdAt DateTime @default(now())
}

// The matched/invited pool for a Requirement (category + city match against
// Active vendors, per society-portal-spec.md Section 5). Only invited
// vendors can see or bid on a Requirement — this is what "blind, matched
// invite" means at the data layer.
model RequirementInvite {
  id                String        @id @default(cuid())
  requirementId     String
  requirement       Requirement   @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  vendorCompanyId   String
  vendorCompany     VendorCompany @relation(fields: [vendorCompanyId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  // Set when the vendor clicks "Show Contact Details" on this requirement —
  // scoped per invite (i.e. per requirement), not per society, so being
  // matched again on a future requirement from the same society starts
  // redacted again. Free today; this is the hook a future credit-spend gate
  // attaches to without touching the matching/invite flow itself.
  contactRevealedAt DateTime?

  @@unique([requirementId, vendorCompanyId])
}

enum BidStatus {
  SUBMITTED
  // Set on finalization (M6) — schema-only for now.
  WON
  NOT_SELECTED
}

// vendor-registration-portal-spec.md Section 8. One Bid per vendor company
// per Requirement (editable up to the deadline); line items are the
// machine-comparable structure the Society side compares post-deadline.
model Bid {
  id                String        @id @default(cuid())
  requirementId     String
  requirement       Requirement   @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  vendorCompanyId   String
  vendorCompany     VendorCompany @relation(fields: [vendorCompanyId], references: [id], onDelete: Cascade)
  submittedByUserId String
  submittedByUser   User          @relation(fields: [submittedByUserId], references: [id])
  totalAmount       Decimal       @db.Decimal(12, 2)
  bidValidity       DateTime
  paymentTerms      String?
  warrantyPeriod    String?
  completionTime    String?
  notes             String?
  status            BidStatus     @default(SUBMITTED)

  // Globally unique, gapless-enough sequence used only to derive the quote
  // PDF's human-readable reference (see quoteReference() in lib/bid-pdf.tsx)
  // — e.g. sequenceNumber 42 in 2026 renders as "Q26-000042". A DB-level
  // autoincrement rather than a formatted string column so there's no race
  // condition between two vendors submitting at the same instant.
  sequenceNumber Int @default(autoincrement())

  // Quote-PDF GST compliance (product decision, 2026-07-23) — a per-quote
  // choice, not tied to whether the vendor's profile has a GST number at
  // all. Snapshotted (not read live off VendorCompany/Society) so the quote
  // PDF stays exactly what was true when submitted, even if either party's
  // GSTIN changes later — same rationale as WorkOrder's *Snapshot fields.
  // The comparison/approval-threshold amount stays totalAmount (pre-tax)
  // regardless of gstCompliant — GST is a pass-through add-on shown only on
  // the PDF, not a factor in ranking vendors against each other.
  gstCompliant             Boolean @default(false)
  vendorGstNumberSnapshot  String?
  societyGstNumberSnapshot String?

  lineItems      BidLineItem[]
  recommendedFor Requirement?  @relation("RequirementRecommendedBid")
  workOrder      WorkOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requirementId, vendorCompanyId])
}

model BidLineItem {
  id          String   @id @default(cuid())
  bidId       String
  bid         Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  // Free text (sqft, nos, lump sum, etc.) — spec calls for a dropdown of
  // common units, not a fixed taxonomy, so this stays a string.
  unit        String
  unitRate    Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  // Null unless the parent Bid is gstCompliant — a per-line-item rate (e.g.
  // materials vs. labour can legitimately sit at different GST slabs), not
  // one flat rate for the whole quote. gstAmount is precomputed at submit
  // time (amount * gstRate/100), same "store the computed value" pattern as
  // amount itself.
  gstRate     Decimal? @db.Decimal(5, 2)
  gstAmount   Decimal? @db.Decimal(12, 2)
}

// A vendor's in-progress quote for a Requirement, saved explicitly via the
// bid form's "Save Draft Quote" button (or auto-populated the first time
// "Suggest line items" succeeds) — entirely separate from Bid so a draft
// never appears anywhere a real submitted quote is read (bid comparison,
// finalization, deadline-reminder "who hasn't bid" check, bid history,
// etc.). Fields are kept as raw strings, mirroring the form's own input
// types, since a draft is allowed to be incomplete/unparseable — only a
// real Bid enforces numeric validity.
model BidDraft {
  id              String        @id @default(cuid())
  requirementId   String
  requirement     Requirement   @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  vendorCompanyId String
  vendorCompany   VendorCompany @relation(fields: [vendorCompanyId], references: [id], onDelete: Cascade)
  bidValidity     String        @default("")
  paymentTerms    String        @default("")
  warrantyPeriod  String        @default("")
  completionTime  String        @default("")
  notes           String        @default("")
  gstCompliant    Boolean       @default(false)
  gstNumber       String        @default("")

  // Stamped the first time "Suggest line items" succeeds for this
  // requirement/vendor pair — its presence is what permanently disables the
  // Suggest button, independent of any later manual Save Draft Quote calls.
  suggestionGeneratedAt DateTime?

  lineItems BidDraftLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requirementId, vendorCompanyId])
}

model BidDraftLineItem {
  id          String   @id @default(cuid())
  bidDraftId  String
  bidDraft    BidDraft @relation(fields: [bidDraftId], references: [id], onDelete: Cascade)
  description String
  quantity    String
  unit        String
  unitRate    String
  gstRate     String   @default("")
}

// ── Messaging & engagement platform (Requirements/messaging-and-engagement-
// spec.md) — Phase 0: an outbox table every outbound email is logged to,
// replacing the previous fire-and-forget direct-to-Resend calls. WhatsApp is
// modeled here (channel/category) so Phase 1 can turn it on without another
// migration, but nothing sends over it yet — see Message.channel below.

enum MessageChannel {
  EMAIL
  WHATSAPP
}

// TRANSACTIONAL/REMINDER are both "the user is owed this because of
// something they or their counterparty did" — always sent regardless of
// marketing preference. MARKETING is the only category gated by
// ContactPreference.emailMarketingOptOutAt (see lib/messaging/dispatcher.ts).
// No marketing sends exist yet in Phase 0 — this exists so Phase 2/3
// campaigns and sequences don't need a schema change to respect opt-outs.
enum MessageCategory {
  TRANSACTIONAL
  REMINDER
  MARKETING
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

// The outbox. Every notify* function in lib/notifications.ts creates one of
// these (via lib/messaging/outbox.ts's enqueueEmail) instead of calling
// Resend directly — see lib/messaging/dispatcher.ts for how rows here get
// sent, retried, and (once RESEND_WEBHOOK_SECRET is set) updated to
// DELIVERED/READ/FAILED from Resend's webhook.
model Message {
  id          String          @id @default(cuid())
  channel     MessageChannel
  category    MessageCategory @default(TRANSACTIONAL)
  // Stable identifier per notification type (e.g. "vendor.bid_outcome"),
  // matching the message catalog in the spec doc — not a foreign key to
  // anything yet, just a tag for logs/analytics until Phase 1's typed
  // per-language WhatsApp template registry is built on top of it.
  templateKey String

  to      String[]
  subject String?
  html    String?
  text    String?

  status        MessageStatus @default(QUEUED)
  skippedReason String?
  error         String?
  attempts      Int           @default(0)
  // Resend's email id (data.id from resend.emails.send) — how the webhook
  // matches an incoming delivery event back to this row.
  providerId    String?
  // Optional caller-supplied idempotency key — a second enqueue with the
  // same key is a silent no-op (see enqueueEmail), for reminder-style sends
  // that must fire at most once per (recipient, event).
  dedupeKey     String?       @unique

  sendAfter   DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sendAfter])
  @@index([templateKey])
  @@index([providerId])
}

// One row per email address (phone joins once WhatsApp lands in Phase 1).
// Created lazily — on first unsubscribe-link visit, or (future) at
// registration — not for every contact up front.
model ContactPreference {
  id    String  @id @default(cuid())
  // Nullable — a WhatsApp-first contact (a vendor who only ever texts in)
  // may have no known email. getOrCreatePreference (email flow) and
  // getOrCreatePreferenceForPhone (WhatsApp flow, lib/messaging/
  // preferences.ts) are the two independent lookup paths into this table;
  // the latter tries to resolve a known email first (via User.phone /
  // VendorCompany.ownerPhone) so the two don't fork into duplicate rows for
  // someone we can actually identify.
  email String? @unique
  phone String? @unique

  // "EN" | "HI" | "MR" — which language template/copy to send this contact.
  // Plain string rather than an enum since Phase 0 has no sender that reads
  // it yet; becomes load-bearing once WhatsApp templates are per-language.
  messageLanguage String @default("EN")

  // Marketing is opt-out (defaults subscribed); the flag alongside the
  // timestamp is redundant on purpose — cheap to query on its own once
  // campaigns exist, without every read having to reason about "timestamp
  // set means opted out".
  subscribedMarketing    Boolean   @default(true)
  emailMarketingOptOutAt DateTime?
  // Set by the Resend webhook on a hard bounce/complaint — blocks ALL
  // categories, not just marketing, since re-sending to a bounced address is
  // pointless regardless of why the email was sent.
  emailSuppressedAt      DateTime?
  suppressionReason      String?

  whatsappOptInAt  DateTime?
  whatsappOptOutAt DateTime?

  unsubscribeToken String @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WebhookProvider {
  RESEND
  WHATSAPP
}

// Raw inbound webhook events, stored before processing so a re-delivered
// event (both Resend and Meta retry on a non-2xx response) is a no-op
// instead of double-processing — see @@unique below.
model WebhookEvent {
  id          String          @id @default(cuid())
  provider    WebhookProvider
  // The provider's own event id (Resend's `data.id`/svix message id; Meta
  // doesn't provide one for status callbacks, so the whatsapp adapter will
  // derive a stable one from the payload when Phase 1 wires it up).
  eventId     String
  eventType   String
  payload     String
  receivedAt  DateTime        @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, eventId])
}

// ── WhatsApp inbound (Phase 1) — Requirements/messaging-and-engagement-
// spec.md, "Conversations + Inbox". One Conversation per phone number;
// InboundMessage rows are every reply. userId/vendorCompanyId/
// assignedToUserId are loose references (no FK), same pattern as
// RoleAssignment.entityId elsewhere in this schema — deliberately not
// wired to User/VendorCompany relations to avoid this table forcing schema
// changes onto those models for what's currently a best-effort resolution.

enum ConversationStatus {
  OPEN
  NEEDS_HUMAN
  CLOSED
}

model Conversation {
  id        String @id @default(cuid())
  // Digits-only, country code + number, no "+" — see lib/whatsapp.ts's
  // toE164India, the single place this value is produced.
  phoneE164 String @unique

  userId          String?
  vendorCompanyId String?

  status           ConversationStatus @default(OPEN)
  assignedToUserId String?

  // Drives the 24h free-form-reply window (Meta's rule, not ours) — see
  // lib/messaging/dispatcher.ts's WhatsApp branch.
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?

  inboundMessages InboundMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum InboundMessageType {
  TEXT
  BUTTON
  INTERACTIVE
  MEDIA
  OTHER
}

enum InboundHandledBy {
  // A structured button/list reply matched a fixed enum and was acted on
  // automatically — see lib/messaging/inbound-triage.ts. Never applies to
  // free text; see that file's doc comment for why.
  AUTO_RULE
  HUMAN
  UNHANDLED
}

model InboundMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Meta's own message id — retried webhook deliveries of the same message
  // are a no-op via this, same idempotency shape as WebhookEvent above.
  providerMessageId String             @unique
  type              InboundMessageType
  text              String?
  // The button/list payload id, when type is BUTTON/INTERACTIVE — matched
  // against inbound-triage.ts's fixed constants (e.g. the opt-out button).
  buttonPayload     String?

  intent        String?
  handledBy     InboundHandledBy @default(UNHANDLED)
  autoReplyText String?

  receivedAt DateTime @default(now())

  @@index([conversationId])
}
